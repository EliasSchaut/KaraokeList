{
  "description": "A web app to view/report/request karaoke songs",
  "author": "EliasSchaut",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/EliasSchaut/KaraokeList#README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliasSchaut/KaraokeList"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "npm run start -w @karaokelist/server",
    "start:client": "npm run start -w @karaokelist/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @karaokelist/server",
    "dev:client": "npm run dev -w @karaokelist/client",
    "test:server": "npm run test -w @karaokelist/server",
    "build": "npm run build:db && concurrently \"npm run build:server\" \"npm run build:client\" \"npm run build:shared\"",
    "build:server": "npm run build -w @karaokelist/server",
    "build:client": "npm run build -w @karaokelist/client",
    "build:shared": "npm run build -w @karaokelist/shared",
    "build:db": "npx prisma migrate dev --schema=./schema.prisma --name dev"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "prisma": "^6.13.0",
    "tsup": "^8.5.0"
  }
}
