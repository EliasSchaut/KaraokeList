{
  "name": "karaoke-list",
  "description": "A web app to view/report/request karaoke songs",
  "author": "EliasSchaut",
  "private": true,
  "license": "MIT",
  "homepage": "https://karaoke.schaut.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliasSchaut/KaraokeList"
  },
  "scripts": {
    "start": "npm run start:server & npm run start:client",
    "start:client": "node .output/server/index.mjs",
    "start:server": "nest start",
    "dev:client": "nuxt dev",
    "dev:server": "nest start --debug --watch",
    "test:server": "jest --config=jest.config.json",
    "build": "npm run build:db && npm run build:server && npm run build:client",
    "build:server": "nest build",
    "build:client": "nuxt build",
    "build:db": "npx prisma generate",
    "migrate:db": "npx prisma migrate dev --schema=./schema.prisma --name dev",
    "format": "prettier --write \\\"server/**/*.ts\\\" \\\"test/**/*.ts\\\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "^6.5.0",
    "@tailwindcss/vite": "^4.0.14",
    "@tanstack/vue-table": "^8.21.2",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.10.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "nestjs-i18n": "^10.5.1",
    "pinia": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "spotify-api.js": "^9.2.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@nuxt/devtools": "^2.3.0",
    "@nuxt/image": "^1.9.0",
    "@nuxtjs/apollo": "^5.0.0-alpha.14",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^9.3.1",
    "@pinia/nuxt": "^0.10.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@vueuse/core": "^13.0.0",
    "@vueuse/nuxt": "^13.0.0",
    "class-transformer": "^0.5.1",
    "dayjs-nuxt": "^2.1.11",
    "jest": "^29.7.0",
    "nestjs-prisma": "^0.25.0",
    "nuxt": "^3.16.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma-error-enum": "^0.1.3",
    "tailwindcss": "^4.0.14",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "vue": "latest"
  }
}
