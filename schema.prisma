// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // other supported databases are "mysql" and "sqlite"
  url      = env("DATABASE_URL") // env("DATABASE_URL")
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model Track {
  id          Int       @id @default(autoincrement())
  title       String
  artist_id   Int
  artist      Artist    @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  genre_id    Int?
  genre       Genre?    @relation(fields: [genre_id], references: [id], onDelete: SetNull)
  language_id Int?
  language    Language? @relation(fields: [language_id], references: [id], onDelete: SetNull)
  edition     String?
  year        Int?
  tags        String?
  cover_url   String?
  audio_url   String?
  video_url   String?
  duet        Boolean   @default(false)
  reports     Report[]

  @@unique([title, artist_id])
}

model Artist {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  tracks Track[]
}

model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  tracks Track[]
}

model Language {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  tracks Track[]
}

model Report {
  id       Int    @id @default(autoincrement())
  track_id Int
  track    Track  @relation(fields: [track_id], references: [id], onDelete: Cascade)
  desc     String
}

model Request {
  id          Int    @id @default(autoincrement())
  track_title String
  artist_name String

  @@unique([track_title, artist_name])
}

model Queue {
  id     Int     @id @default(autoincrement())
  active Boolean @default(false)
  host   String?
}
